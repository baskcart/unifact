{
  "name": "unifact",
  "version": "0.2.0",
  "description": "Governed fact registry for organizations — unique facts with provenance, versions, and approval",
  "keywords": [
    "unifact",
    "facts",
    "mcp",
    "agents",
    "source-of-truth",
    "organizational-knowledge",
    "cursor",
    "claude",
    "codex"
  ],
  "homepage": "https://www.unifact.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baskcart/unifact.git"
  },
  "main": "dist/api.js",
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "start": "tsx src/api.ts",
    "seed": "tsx src/seed.ts",
    "build": "tsc",
    "test": "tsx --test src/**/*.test.ts",
    "mcp": "tsx src/mcp.ts",
    "cli": "tsx src/cli.ts",
    "uni": "tsx src/cli.ts"
  },
  "bin": {
    "uni": "./dist/cli.js",
    "unifact": "./dist/cli.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.22.0",
    "yaml": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
