{
  "name": "unifact",
  "version": "0.2.0",
  "description": "Governed fact registry for organizations — unique facts with provenance, versions, and approval",
  "keywords": [
    "unifact",
    "facts",
    "mcp",
    "agents",
    "source-of-truth",
    "organizational-knowledge",
    "cursor",
    "claude",
    "codex"
  ],
  "homepage": "https://www.unifact.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baskcart/unifact.git"
  },
  "main": "dist/api.js",
  "files": [
    "dist/",
    "docs/",
    "integrations/",
    "README.md",
    "AGENTS.md",
    "CLAUDE.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/api.ts",
    "start": "tsx src/api.ts",
    "seed": "tsx src/seed.ts",
    "build": "tsc",
    "mcp": "tsx src/mcp.ts",
    "mcp:prod": "node dist/mcp.js",
    "cli": "tsx src/cli.ts",
    "uni": "tsx src/cli.ts",
    "test": "npm run build && node scripts/verify-mcp.mjs && node scripts/verify-integrations.mjs && node scripts/verify-key-import.mjs && node scripts/verify-onboarding.mjs",
    "build:claude-desktop": "npm run build && node scripts/build-claude-desktop.mjs",
    "build:claude-linked": "npm run build && node scripts/build-claude-linked.mjs",
    "prepack": "npm run build"
  },
  "bin": {
    "uni": "./dist/cli.js",
    "unifact": "./dist/cli.js",
    "unifact-mcp": "./dist/mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.22.0",
    "yaml": "^2.4.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.20.0",
    "tsx": "^4.15.7",
    "typescript": "^5.4.5"
  }
}
